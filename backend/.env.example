# Kopieer hierdie leer na .env en vul die regte waardes in.
# MOENIE .env na GitHub stuur nie - dit staan in .gitignore.

# Supabase (Postgres) - gebruik die pooler, nie die direkte adres nie
PGHOST=aws-1-eu-west-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.fbtxfuhwxgntpywcapru
PGPASSWORD=jou_wagwoord_hier

# Express
PORT=3000

# Google-aanmelding
# Kry hierdie by https://console.cloud.google.com
#   APIs & Services -> Credentials -> OAuth client ID
#
# Authorised JavaScript origins:  http://localhost:5173
# Authorised redirect URIs:       http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Waar die gebruiker beland nadat Google hulle terugstuur
FRONTEND_URL=http://localhost:5173

# Meta-aanmelding (Facebook)
# Kry hierdie by https://developers.facebook.com
#   Jou app -> Settings -> Basic
#
# By Facebook Login -> Settings:
#   Valid OAuth Redirect URIs:  (die META_REDIRECT_URI hieronder)
#
# LET WEL: Meta weier gewoonlik http://localhost as 'n redirect.
# Gebruik 'n werklike HTTPS-domein, of 'n tonnel soos ngrok.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Nominatim (OpenStreetMap se reverse geocoding)
#
# Nominatim vra 'n kontakadres in die User-Agent - sonder dit mag
# hulle die versoeke blokkeer. Gebruik jou eie e-posadres.
#
# Die diens is gratis, maar die reëls is streng: maksimum een
# versoek per sekonde, geen massa-navrae, en moenie resultate
# hergebruik asof dit jou eie data is nie.
NOMINATIM_CONTACT=jou@eposadres.co.za
